{
  "name": "@0verlabs/herald-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "dev": "bun --hot run src/index.ts",
    "test": "vitest",
    "check": "bun run check:lint && bun run check:types",
    "check:lint": "biome check . --write",
    "check:types": "tsc --noEmit",
    "check:staged": "biome check . --write --staged --files-ignore-unknown=true --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "uuid": "catalog:",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.19",
    "@ai-sdk/openai-compatible": "3.0.14",
    "@circle-fin/adapter-viem-v2": "1.14.1",
    "@circle-fin/app-kit": "1.11.0",
    "@clerk/backend": "catalog:",
    "@clerk/hono": "0.1.58",
    "@hono/zod-validator": "0.9.0",
    "@0verlabs/herald-db": "workspace:",
    "@privy-io/node": "catalog:",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "viem": "2.55.10",
    "zod": "catalog:"
  }
}
