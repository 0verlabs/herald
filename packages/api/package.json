{
  "name": "@hrld/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "dev": "bun --hot run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check": "bun run check:lint && bun run check:types",
    "check:lint": "biome check . --write",
    "check:types": "tsc --noEmit",
    "check:staged": "biome check . --write --staged --files-ignore-unknown=true --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.0",
    "@hrld/core": "workspace:",
    "@hrld/db": "workspace:",
    "@hrld/indexer": "workspace:",
    "@ponder/client": "0.17.8",
    "@privy-io/node": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "viem": "catalog:",
    "zod": "catalog:"
  }
}
