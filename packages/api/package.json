{
  "name": "@ivanius.ai/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest",
    "check": "bun run check:lint && bun run check:types",
    "check:lint": "biome check . --write",
    "check:types": "wrangler types && tsc --noEmit",
    "check:staged": "biome check . --write --staged --files-ignore-unknown=true --no-errors-on-unmatched",
    "db:migrate:local": "wrangler d1 migrations apply ivanius_ai --local"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "uuid": "catalog:",
    "vitest": "3.2.7",
    "wrangler": "catalog:"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.19",
    "@ai-sdk/openai-compatible": "3.0.14",
    "@circle-fin/developer-controlled-wallets": "10.8.0",
    "@clerk/backend": "catalog:",
    "@clerk/hono": "0.1.58",
    "@hono/zod-validator": "0.9.0",
    "@ivanius.ai/db": "workspace:",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  }
}
