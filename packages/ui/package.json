{
  "name": "@ivanius.ai/ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "check": "bun run check:lint && bun run check:types",
    "check:lint": "biome check . --write",
    "check:types": "tsc --noEmit",
