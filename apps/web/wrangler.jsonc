// Herald dashboard (TanStack Start).
//
// The top level is the local development config (`vp dev`). `testnet` and
// `production` are the deployed environments, picked at build time with
// CLOUDFLARE_ENV. The `HERALD_ENV` var tells the code which Herald environment it is
// (`testnet` or `mainnet`). Bindings and vars are not inherited, so each
// environment declares its own. D1 is
// shared with the facilitator: same database per environment.
//
// NEAR_RPC_URL (a secret: a private QuickNode endpoint whose URL carries the
// API key) is the NEAR network of the Herald environment. Sign-in checks
// there that the signing key is a full-access key of the Provider Account.
// <CHAIN>_RPC_URL (secrets too, the same private endpoints the facilitator
// uses) are the JSON-RPC endpoints of each chain Herald lists in the
// environment: BASE, SOLANA and ARBITRUM, plus POLYGON and AVALANCHE on
// mainnet. Overview reads the Receiving Addresses' live USDC balances there.
// Set them with `CLOUDFLARE_ENV=<env> wrangler secret put <NAME>`, and
// locally in `.dev.vars` (see `.dev.vars.example`). `secrets` is not
// inherited, so each environment declares them.
// SESSIONS holds dashboard sessions. SIGN_IN_RATE_LIMITER allows 20 sign-in
// requests (challenges and signatures) per minute per client IP.
//
// SOLANA_CHAIN_QUEUE, EVM_CHAIN_QUEUE and NEAR_CHAIN_QUEUE are the
// facilitator's chain queues (ADR-0006), bound across Workers with
// `script_name`: the facilitator Worker of the same environment. The NEAR one
// names Herald's NEAR relayer for the admin page. Registration queues each Provider's Solana USDC
// token account on the Solana one; Sweeps submit their signed transfers
// through the queue of their chain, which pays the gas (on Solana, as the
// transaction's fee payer). Locally, run the facilitator with `wrangler dev`
// alongside. Sweeps also read the MPC signature from NEAR over NEAR_RPC_URL,
// and transfer receipts, blockhashes and signature statuses over
// <CHAIN>_RPC_URL.
//
// Cross-chain and NEAR Intents Sweeps (mainnet only) call 1Click at
// https://1click.chaindefuser.com. ONE_CLICK_JWT, a 1Click partner key, is an
// optional secret: 1Click quotes without it. It stays out of
// `secrets.required`, since `wrangler deploy` refuses to deploy while a
// required secret is missing; `wrangler types` therefore doesn't type it.
//
// The admin page (/admin) is for Herald admins only; everyone else gets a
// 404. HERALD_ADMINS is the allowlist: NEAR account ids of the environment,
// comma-separated ("ops.near, alice.near"). Empty means nobody. The page
// shows each chain's gas wallet (its address from the chain queue, its
// balance over <CHAIN>_RPC_URL) and warns when a balance falls below
// GAS_LOW_BALANCE_THRESHOLDS: whole native tokens (NEAR, ETH, SOL, POL, AVAX)
// keyed by CAIP-2 network. A network left out never warns. NEAR's gas wallet
// is the relayer, at 0.5 NEAR in both environments; `near:mainnet` is set
// ahead of Herald listing NEAR on mainnet and takes effect once it does.
// Admins also edit the Sweep minimums there, in D1, without a deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "herald-web",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "HERALD_ENV": "testnet",
    "HERALD_ADMINS": "",
    "GAS_LOW_BALANCE_THRESHOLDS": {
      "near:testnet": "0.5",
      "eip155:84532": "0.01",
      "solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1": "0.5",
      "eip155:421614": "0.01",
    },
  },
  "secrets": {
    "required": ["NEAR_RPC_URL", "BASE_RPC_URL", "SOLANA_RPC_URL", "ARBITRUM_RPC_URL"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SOLANA_CHAIN_QUEUE",
        "class_name": "SolanaChainQueue",
        "script_name": "herald-facilitator",
      },
      {
        "name": "EVM_CHAIN_QUEUE",
        "class_name": "EvmChainQueue",
        "script_name": "herald-facilitator",
      },
      {
        "name": "NEAR_CHAIN_QUEUE",
        "class_name": "NearChainQueue",
        "script_name": "herald-facilitator",
      },
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "herald-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
      "migrations_pattern": "../../packages/db/migrations/*/migration.sql",
    },
  ],
  "kv_namespaces": [{ "binding": "SESSIONS", "id": "00000000000000000000000000000000" }],
  "ratelimits": [
    {
      "name": "SIGN_IN_RATE_LIMITER",
      "namespace_id": "4020",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "env": {
    "testnet": {
      "name": "herald-web-testnet",
      "vars": {
        "HERALD_ENV": "testnet",
        "HERALD_ADMINS": "",
        "GAS_LOW_BALANCE_THRESHOLDS": {
          "near:testnet": "0.5",
          "eip155:84532": "0.01",
          "solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1": "0.5",
          "eip155:421614": "0.01",
        },
      },
      "secrets": {
        "required": ["NEAR_RPC_URL", "BASE_RPC_URL", "SOLANA_RPC_URL", "ARBITRUM_RPC_URL"],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "SOLANA_CHAIN_QUEUE",
            "class_name": "SolanaChainQueue",
            "script_name": "herald-facilitator-testnet",
          },
          {
            "name": "EVM_CHAIN_QUEUE",
            "class_name": "EvmChainQueue",
            "script_name": "herald-facilitator-testnet",
          },
          {
            "name": "NEAR_CHAIN_QUEUE",
            "class_name": "NearChainQueue",
            "script_name": "herald-facilitator-testnet",
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "herald-testnet",
          "database_id": "2498f5b7-647d-4322-ba87-64acf452bca0",
          "migrations_dir": "../../packages/db/migrations",
          "migrations_pattern": "../../packages/db/migrations/*/migration.sql",
        },
      ],
      "kv_namespaces": [{ "binding": "SESSIONS", "id": "2fafa42fee0c42a3891c9c665817324a" }],
      "ratelimits": [
        {
          "name": "SIGN_IN_RATE_LIMITER",
          "namespace_id": "4021",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
    },
    "production": {
      "name": "herald-web-mainnet",
      "vars": {
        "HERALD_ENV": "mainnet",
        "HERALD_ADMINS": "",
        "GAS_LOW_BALANCE_THRESHOLDS": {
          "near:mainnet": "0.5",
          "eip155:8453": "0.002",
          "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp": "0.05",
          "eip155:42161": "0.002",
          "eip155:137": "2",
          "eip155:43114": "0.1",
        },
      },
      "secrets": {
        "required": [
          "NEAR_RPC_URL",
          "BASE_RPC_URL",
          "SOLANA_RPC_URL",
          "ARBITRUM_RPC_URL",
          "POLYGON_RPC_URL",
          "AVALANCHE_RPC_URL",
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "SOLANA_CHAIN_QUEUE",
            "class_name": "SolanaChainQueue",
            "script_name": "herald-facilitator-mainnet",
          },
          {
            "name": "EVM_CHAIN_QUEUE",
            "class_name": "EvmChainQueue",
            "script_name": "herald-facilitator-mainnet",
          },
          {
            "name": "NEAR_CHAIN_QUEUE",
            "class_name": "NearChainQueue",
            "script_name": "herald-facilitator-mainnet",
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "herald-mainnet",
          "database_id": "40572b28-f964-40ff-a8ef-3676a0f1629a",
          "migrations_dir": "../../packages/db/migrations",
          "migrations_pattern": "../../packages/db/migrations/*/migration.sql",
        },
      ],
      "kv_namespaces": [{ "binding": "SESSIONS", "id": "3ea666d940fe4fe685da650003bc1de7" }],
      "ratelimits": [
        {
          "name": "SIGN_IN_RATE_LIMITER",
          "namespace_id": "4022",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
    },
  },
}
