{
  "name": "@herald/facilitator",
  "version": "0.0.0",
  "private": true,
  "description": "Herald's x402 facilitator Worker (Hono).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --persist-to ../../.wrangler/state",
    "build": "wrangler deploy --dry-run --outdir dist",
    "types": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to ../../.wrangler/state",
    "db:migrate:remote": "test -n \"$CLOUDFLARE_ENV\" || { echo \"Set CLOUDFLARE_ENV to testnet or production\" >&2; exit 1; } && wrangler d1 migrations apply DB --remote",
    "deploy": "test -n \"$CLOUDFLARE_ENV\" || { echo \"Set CLOUDFLARE_ENV to testnet or production\" >&2; exit 1; } && wrangler deploy",
    "seed": "node scripts/seed.ts"
  },
  "dependencies": {
    "@herald/core": "workspace:*",
    "@herald/db": "workspace:*",
    "@scure/base": "catalog:",
    "@solana-program/token": "catalog:",
    "@solana/kit": "catalog:",
    "@x402/core": "catalog:",
    "@x402/evm": "catalog:",
    "@x402/svm": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@hrld/x402": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
