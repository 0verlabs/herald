// Herald's x402 facilitator.
//
// The top level is the local development config (`wrangler dev`, tests).
// `testnet` and `production` are the deployed environments, picked with
// CLOUDFLARE_ENV. The `HERALD_ENV` var tells the code which Herald environment it is
// (`testnet` or `mainnet`). Bindings and vars are not inherited, so each
// environment declares its own.
//
// SETTLE_RECEIPT_TIMEOUT_MS bounds the receipt wait in /settle; past it the
// answer is `settlement_pending` and the resource server retries once. On
// NEAR, which has no pending answer, it bounds the wait for the relayer
// transaction to be final.
//
// Secrets (declared in `secrets.required` at the top level and in each
// environment, since `secrets` is not inherited), never their values in this
// file. Set them with `CLOUDFLARE_ENV=<env> wrangler secret put <NAME>`, and
// locally in `.dev.vars` (see `.dev.vars.example`):
//
// - EVM_GAS_KEY: 0x-prefixed hex private key of the gas wallet shared by
//   every EVM chain.
// - SOLANA_GAS_KEY: base58 64-byte secret key of the Solana fee payer.
// - <CHAIN>_RPC_URL: the JSON-RPC endpoint of each chain Herald lists in the
//   environment (BASE, SOLANA, ARBITRUM; POLYGON and AVALANCHE on mainnet
//   only), for that environment's network: Base Sepolia and Solana Devnet on
//   testnet. They are private QuickNode endpoints whose URL carries the API
//   key. Solana's public endpoints refuse requests from Workers anyway.
// - NEAR_RPC_URL: the NEAR endpoint (NEAR testnet or mainnet) for the MPC
//   root-key check before settling, and for NEAR settlements.
// - NEAR_RELAYER_KEY: near-cli private key (`ed25519:<base58 64-byte secret
//   key>`) of the NEAR relayer, an implicit account (its id is the hex of
//   the public key). It pays the gas of NEAR settlements; only the
//   NearChainQueue Durable Object uses it. scripts/near-relayer-wizard.sh
//   creates it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "herald-facilitator",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "secrets": {
    "required": [
      "EVM_GAS_KEY",
      "SOLANA_GAS_KEY",
      "BASE_RPC_URL",
      "SOLANA_RPC_URL",
      "ARBITRUM_RPC_URL",
      "NEAR_RPC_URL",
      "NEAR_RELAYER_KEY",
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["EvmChainQueue"] },
    { "tag": "v2", "new_sqlite_classes": ["SolanaChainQueue"] },
    { "tag": "v3", "new_sqlite_classes": ["NearChainQueue"] },
  ],
  "vars": {
    "HERALD_ENV": "testnet",
    "SETTLE_RECEIPT_TIMEOUT_MS": "30000",
  },
  "durable_objects": {
    "bindings": [
      { "name": "EVM_CHAIN_QUEUE", "class_name": "EvmChainQueue" },
      { "name": "SOLANA_CHAIN_QUEUE", "class_name": "SolanaChainQueue" },
      { "name": "NEAR_CHAIN_QUEUE", "class_name": "NearChainQueue" },
    ],
  },
  // Per API key: 60 settle and 120 verify requests per minute.
  "ratelimits": [
    {
      "name": "SETTLE_RATE_LIMITER",
      "namespace_id": "4000",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "VERIFY_RATE_LIMITER",
      "namespace_id": "4010",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "herald-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
      "migrations_pattern": "../../packages/db/migrations/*/migration.sql",
    },
  ],
  "env": {
    "testnet": {
      "name": "herald-facilitator-testnet",
      "secrets": {
        "required": [
          "EVM_GAS_KEY",
          "SOLANA_GAS_KEY",
          "BASE_RPC_URL",
          "SOLANA_RPC_URL",
          "ARBITRUM_RPC_URL",
          "NEAR_RPC_URL",
          "NEAR_RELAYER_KEY",
        ],
      },
      "vars": {
        "HERALD_ENV": "testnet",
        "SETTLE_RECEIPT_TIMEOUT_MS": "30000",
      },
      "durable_objects": {
        "bindings": [
          { "name": "EVM_CHAIN_QUEUE", "class_name": "EvmChainQueue" },
          { "name": "SOLANA_CHAIN_QUEUE", "class_name": "SolanaChainQueue" },
          { "name": "NEAR_CHAIN_QUEUE", "class_name": "NearChainQueue" },
        ],
      },
      "ratelimits": [
        {
          "name": "SETTLE_RATE_LIMITER",
          "namespace_id": "4001",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "VERIFY_RATE_LIMITER",
          "namespace_id": "4011",
          "simple": { "limit": 120, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "herald-testnet",
          "database_id": "2498f5b7-647d-4322-ba87-64acf452bca0",
          "migrations_dir": "../../packages/db/migrations",
          "migrations_pattern": "../../packages/db/migrations/*/migration.sql",
          // Lets the seed script (`scripts/seed.ts --env testnet`) write to
          // the deployed database. Ignored by `wrangler deploy`.
          "remote": true,
        },
      ],
    },
    "production": {
      "name": "herald-facilitator-mainnet",
      "secrets": {
        "required": [
          "EVM_GAS_KEY",
          "SOLANA_GAS_KEY",
          "BASE_RPC_URL",
          "SOLANA_RPC_URL",
          "ARBITRUM_RPC_URL",
          "NEAR_RPC_URL",
          "NEAR_RELAYER_KEY",
          "POLYGON_RPC_URL",
          "AVALANCHE_RPC_URL",
        ],
      },
      "vars": {
        "HERALD_ENV": "mainnet",
        "SETTLE_RECEIPT_TIMEOUT_MS": "30000",
      },
      "durable_objects": {
        "bindings": [
          { "name": "EVM_CHAIN_QUEUE", "class_name": "EvmChainQueue" },
          { "name": "SOLANA_CHAIN_QUEUE", "class_name": "SolanaChainQueue" },
          { "name": "NEAR_CHAIN_QUEUE", "class_name": "NearChainQueue" },
        ],
      },
      "ratelimits": [
        {
          "name": "SETTLE_RATE_LIMITER",
          "namespace_id": "4002",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "VERIFY_RATE_LIMITER",
          "namespace_id": "4012",
          "simple": { "limit": 120, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "herald-mainnet",
          "database_id": "40572b28-f964-40ff-a8ef-3676a0f1629a",
          "migrations_dir": "../../packages/db/migrations",
          "migrations_pattern": "../../packages/db/migrations/*/migration.sql",
        },
      ],
    },
  },
}
