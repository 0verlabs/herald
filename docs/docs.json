{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Herald",
  "description": "Herald is the Agent Commerce Protocol: on-chain identity, payment rails, and a discovery network for AI agents.",
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://docs.heraldprotocol.xyz",
      "og:site_name": "Herald Docs",
      "og:locale": "en_US",
      "twitter:card": "summary_large_image",
      "twitter:site": "@hrld_ai",
      "author": "Herald",
      "category": "Technology"
    },
    "organization": {
      "name": "Herald",
      "url": "https://heraldprotocol.xyz",
      "sameAs": ["https://x.com/hrld_ai", "https://github.com/0verlabs"]
    }
  },
  "thumbnails": {
    "background": "/images/og-background.png"
  },
  "colors": {
    "primary": "#5205ab",
    "light": "#c596fa",
    "dark": "#5c16c9"
  },
  "background": {
    "decoration": "gradient"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "Lora"
    },
    "body": {
      "family": "Figtree"
    }
  },
  "navigation": {
    "pages": [
      {
        "group": "Welcome",
        "pages": ["pages/welcome/introduction", "pages/welcome/architecture", "pages/welcome/faq"]
      },
      {
        "group": "Product",
        "pages": [
          "pages/product/network",
          "pages/product/wallet",
          {
            "group": "Rails",
            "pages": [
              "pages/product/rails/rails",
              "pages/product/rails/direct",
              "pages/product/rails/escrow"
            ]
          },
          "pages/product/storage",
          "pages/product/private-inference"
        ]
      },
      {
        "group": "Tools",
        "pages": ["pages/tools/cli", "pages/tools/mcp"]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/0verlabs"
        },
        {
          "anchor": "X",
          "icon": "x-twitter",
          "href": "https://x.com/hrld_ai"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/hrld_ai",
      "github": "https://github.com/0verlabs"
    }
  },
  "redirects": [
    { "source": "/introduction", "destination": "/pages/welcome/introduction" },
    { "source": "/architecture", "destination": "/pages/welcome/architecture" },
    { "source": "/faq", "destination": "/pages/welcome/faq" },
    { "source": "/network", "destination": "/pages/product/network" },
    { "source": "/wallet", "destination": "/pages/product/wallet" },
    { "source": "/private-inference", "destination": "/pages/product/private-inference" },
    { "source": "/rails", "destination": "/pages/product/rails/rails" },
    { "source": "/direct", "destination": "/pages/product/rails/direct" },
    { "source": "/escrow", "destination": "/pages/product/rails/escrow" },
    { "source": "/storage", "destination": "/pages/product/storage" },
    { "source": "/cli", "destination": "/pages/tools/cli" },
    { "source": "/mcp", "destination": "/pages/tools/mcp" }
  ]
}
